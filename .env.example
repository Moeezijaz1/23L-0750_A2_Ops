# Copy to .env (git-ignored) and fill in. Never commit the real file.
# --- DagsHub / MLflow (training machine only) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<ROLLNO_A2_Ops>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>
MLFLOW_EXPERIMENT_NAME=ROLLNO_A2_Ops
REGISTERED_MODEL_NAME=ROLLNO_A2_Ops_VisionGuard
# --- Web app ---
SECRET_KEY=change-me
MODEL_PATH=/models/champion.keras
THRESHOLD=0.5
MAX_UPLOAD_MB=5
INFERENCE_MODE=local            # local | remote
REMOTE_API_URL=http://<cloud-ip>:8000
REMOTE_API_KEY=change-me-long-random
# --- Database (Compose) ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visionguard
