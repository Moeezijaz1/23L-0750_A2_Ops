FROM python:3.11-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY vg ./vg
COPY app ./app
COPY model_api ./model_api
COPY models ./models

ENV MODEL_PATH=/app/models/champion.keras

EXPOSE 10000

CMD ["sh", "-c", "gunicorn -w 1 --timeout 120 -b 0.0.0.0:${PORT:-10000} model_api.app:app"]
